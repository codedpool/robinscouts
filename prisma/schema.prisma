// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Job {
  id               String   @id @default(uuid())
  company          String
  title            String
  titleNormalized  String
  location         String // JSON-stringified array, e.g. ["Remote","India"]
  employmentType   String // internship | entry-level | full-time | unspecified
  experience       String   @default("unspecified")
  skills           String   @default("[]") // JSON-stringified array
  salary           String?
  description      String   @default("")
  sourceUrl        String
  applicationUrl   String   @unique
  source           String // e.g. "onehouse-lever-custom"
  firstSeenAt      DateTime @default(now())
  lastSeenAt       DateTime @updatedAt
  lastChangedAt    DateTime @default(now()) // only touched when contentHash actually changes
  changeSummary    String? // human-readable description of the last real change, null if never changed
  missingSince     DateTime? // first healthy run that didn't see this job; cleared if it reappears
  lastRunChangeType String? // new | updated | unchanged | possibly_closed — set every healthy run
  contentHash      String
  status           String   @default("active") // active | possibly_closed
  duplicateOfId    String?
  rawJson          String // raw scraper output for this record, for debugging
  sessionId        String? // null for the two static sources; set for a visitor-added source's jobs

  @@index([source])
  @@index([status])
  @@index([sessionId])
}

model SourceStatus {
  source        String    @id // matches Job.source
  label         String
  status        String    @default("healthy") // healthy | unhealthy
  lastCheckedAt DateTime  @updatedAt
  lastSuccessAt DateTime?
  lastError     String?
  jobCount      Int       @default(0)
}

// A visitor-added source, created live via their own Bright Data API key.
// The two built-in sources (Onehouse, Sourcegraph) are NOT rows here — they
// stay in src/lib/sources.js. Only self-service "add a company" sources
// live in this table, scoped to the browser session that created them.
model Source {
  id          String   @id @default(uuid())
  key         String   @unique // matches Job.source, e.g. "user-acme-corp-<ts>"
  label       String
  company     String
  url         String
  collectorId String
  sessionId   String
  createdAt   DateTime @default(now())

  @@index([sessionId])
}
